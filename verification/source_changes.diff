+def block_eigenvalues(x):
+    """Certified eigenvalues for an excitation-preserving two-qubit state."""
+    assert x.real.shape==(4,4)
+    for i in range(4):
+        for j in range(4):
+            if i.bit_count()!=j.bit_count():assert x.real[i,j]==x.imag[i,j]==0
+    a=as_iv(x.frac(0,0)[0]);d=as_iv(x.frac(3,3)[0]);b=as_iv(x.frac(1,1)[0]);c=as_iv(x.frac(2,2)[0]);rr,ii=x.frac(1,2)
